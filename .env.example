# 本地开发用 .env 模板（复制为 .env 后填入真实 key；.env 已 gitignore，不会提交）
# Compose 默认把后端容器的 8000 发布到宿主机 8001，避免常见的 8000 冲突。
BACKEND_PUBLISHED_PORT=8001
# 若前端要连接手动启动的 Uvicorn，可改为 http://localhost:8000。
VITE_BACKEND_PROXY_TARGET=http://localhost:8001

# 激活 route agent：/routes/adjust 走 QwenPaw route agent，失败降级规则版
ROUTE_AGENT_ENABLED=false

# 激活需求理解 agent：/intent/parse 走 QwenPaw intent agent，失败降级规则版
# （QwenPaw 里 intent agent 建好前，留 true 也安全——agent 不可用会自动降级 source=rules）
INTENT_AGENT_ENABLED=false

# 激活多轮偏好引导 agent：/intent/guide 走 QwenPaw pref-guide agent，失败时降级为脚本版
PREFERENCE_GUIDE_AGENT_ENABLED=false

# 激活独立审核 agent：/review/content 走 QwenPaw reviewer agent，失败降级规则版红线扫描
REVIEWER_AGENT_ENABLED=false

# QwenPaw 本地实例（默认值即可，显式写明）
QWENPAW_BASE_URL=http://127.0.0.1:8088
QWENPAW_DEFAULT_AGENT_ID=default
QWENPAW_TIMEOUT=60.0

# 百炼 / DashScope：部署者自行申请并承担配额/费用的 Key（TTS、embedding、明信片 AI 场景图）。
# 这不是赛委会提供的 Key；请勿提交真实值。
# Docker 会从本文件或宿主机环境变量注入到 backend 容器
DASHSCOPE_API_KEY=

# Qwen-Image 专用 key。Scene Agent 只读取此项，不会回落到 embedding key。
QWEN_IMAGE_API_KEY=
# QwenPaw 图片工具使用 DashScope 原生北京端点，不使用 /compatible-mode/v1。
QWEN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-2.0-pro

# RAG 向量检索专用 key（text-embedding-v3）；留空回落 DASHSCOPE_API_KEY
QWEN_EMBEDDING_API_KEY=


# Phase 3 向量检索开关（pgvector 已起 + ingest 完成后开）
PGVECTOR_ENABLED=false

# 文化讲解 agent 开关（QwenPaw 建 guide agent 后置 true）
GUIDE_AGENT_ENABLED=false
GUIDE_AGENT_MAX_DURATION=8.0
GUIDE_AGENT_FAILURE_COOLDOWN=30.0
GUIDE_AGENT_CACHE_TTL=3600.0

# QwenPaw TTS：在 guide Agent 挂载 qwen-tts-tool 后置 true。
# Plugin 不可用时仅在明确允许时回落到后端直连 DashScope。
QWENPAW_TTS_ENABLED=false
QWENPAW_TTS_AGENT_ID=guide
QWENPAW_TTS_DIRECT_FALLBACK_ENABLED=true

# 拍照识别 agent 开关（QwenPaw 建 photo agent 后置 true）
PHOTO_AGENT_ENABLED=false

# Postcard AI scene when user skips photo upload (QwenPaw scene + Qwen-Image)
POSTCARD_AI_IMAGE_ENABLED=true
POSTCARD_AI_IMAGE_SIZE=2368*1728
POSTCARD_AI_SCENE_TIMEOUT=210

# ---------- 高德地图（https://lbs.amap.com/dev/）----------
# Web 服务 Key：后端 /api/v1/routes/walk-path 路径规划用（控制台创建「Web服务」类型）
AMAP_WEB_SERVICE_KEY=

# Web 端 JS API Key：前端地图展示用（控制台创建「Web端(JS API)」类型）
AMAP_API_KEY=
# JS API 安全密钥（高德新规；与 Web 端 Key 成对，在控制台「安全密钥」里查看）
AMAP_SECURITY_CODE=

# Vite 前端可读（浏览器端）；与上面 Web 端 Key / 安全密钥填同一套值
VITE_AMAP_API_KEY=
VITE_AMAP_SECURITY_CODE=
