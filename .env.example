# ============================================================
# 澳跡同行 Macau StoryWalk — 环境变量模板
# ------------------------------------------------------------
# 用法：
#   1) 复制本文件为 .env ：  cp .env.example .env
#   2) 在 .env 中填入真实 key（.env 已被 .gitignore 忽略，不会提交）
#   3) 后端 backend/app/core/config.py 会自动读取 .env
#
# ⚠️  切勿把真实 API Key 提交到 Git！不要把 .env 推到远端。
# ⚠️  团队成员各自申请自己的 key，不要在群/文档里明文传 key。
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=dev                         # dev / staging / prod
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO                      # DEBUG / INFO / WARNING / ERROR

# 前端（Vite 以 VITE_ 前缀暴露给浏览器；留空则前端走相对路径 / 经 vite proxy）
FRONTEND_PORT=5173
VITE_API_BASE_URL=

# ---------- QwenPaw / 阿里云百炼 / DashScope（核心：Agent + Embedding + TTS）----------
# 控制台：https://bailian.console.aliyun.com/   API Key：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=
QWENPAW_APP_ID=                     # QwenPaw 应用 ID
QWENPAW_API_KEY=                    # QwenPaw 应用专用 key（若与 DashScope 共用可填同值）
# 模型 ID（百炼模型名，按需调整）
QWEN_TEXT_MODEL=qwen-plus           # 对话/讲解/路线微调
QWEN_VISION_MODEL=qwen-vl-max       # 拍照识别（多模态）
QWEN_EMBEDDING_MODEL=text-embedding-v3   # RAG 向量化
QWEN_TTS_MODEL=cosyvoice-v1         # 语音导览（含粤语/葡语）

# ---------- 地图 SDK（高德 / AMap，澳门 POI 与步行路径）----------
# https://lbs.amap.com/dev/
AMAP_API_KEY=                       # Web 端 JS API key
AMAP_WEB_SERVICE_KEY=               # Web 服务 key（后端调路径规划/地理编码）
AMAP_SECURITY_CODE=                 # JS API 安全密钥（高德新规）

# ---------- 数据库 / 向量库 ----------
# Phase 1 可保持 PGVECTOR_ENABLED=false，先用 data/*.json；Phase 3 接 RAG 时再开
DATABASE_URL=postgresql+psycopg://macau:macau@localhost:5432/macau
PGVECTOR_ENABLED=false

# ---------- 认证 / 会话 ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080            # 默认 7 天

# ---------- 语音 / 多模态（如使用独立 TTS 服务，否则用上面 Qwen TTS）----------
TTS_API_KEY=

# ---------- 外部实时数据（Phase 4 可选接入）----------
WEATHER_API_KEY=                    # 天气 API
CROWD_API_KEY=                      # 人流数据（口岸/景点）
