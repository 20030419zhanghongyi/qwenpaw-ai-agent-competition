# 本地开发用 .env 模板（复制为 .env 后填入真实 key；.env 已 gitignore，不会提交）
# 激活 route agent：/routes/adjust 走 QwenPaw route agent，失败降级规则版
ROUTE_AGENT_ENABLED=false

# 激活需求理解 agent：/intent/parse 走 QwenPaw intent agent，失败降级规则版
# （QwenPaw 里 intent agent 建好前，留 true 也安全——agent 不可用会自动降级 source=rules）
INTENT_AGENT_ENABLED=false

# 激活独立审核 agent：/review/content 走 QwenPaw reviewer agent，失败降级规则版红线扫描
REVIEWER_AGENT_ENABLED=false

# QwenPaw 本地实例（默认值即可，显式写明）
QWENPAW_BASE_URL=http://127.0.0.1:8088
QWENPAW_DEFAULT_AGENT_ID=default
QWENPAW_TIMEOUT=60.0

# RAG 向量检索专用 key（text-embedding-v3）；留空回落 DASHSCOPE_API_KEY
QWEN_EMBEDDING_API_KEY=


# Phase 3 向量检索开关（pgvector 已起 + ingest 完成后开）
PGVECTOR_ENABLED=false

# 文化讲解 agent 开关（QwenPaw 建 guide agent 后置 true）
GUIDE_AGENT_ENABLED=false

# 拍照识别 agent 开关（QwenPaw 建 photo agent 后置 true）
PHOTO_AGENT_ENABLED=false

# ---------- 高德地图（https://lbs.amap.com/dev/）----------
# Web 服务 Key：后端 /api/v1/routes/walk-path 路径规划用（控制台创建「Web服务」类型）
AMAP_WEB_SERVICE_KEY=

# Web 端 JS API Key：前端地图展示用（控制台创建「Web端(JS API)」类型）
AMAP_API_KEY=
# JS API 安全密钥（高德新规；与 Web 端 Key 成对，在控制台「安全密钥」里查看）
AMAP_SECURITY_CODE=

# Vite 前端可读（浏览器端）；与上面 Web 端 Key / 安全密钥填同一套值
VITE_AMAP_API_KEY=
VITE_AMAP_SECURITY_CODE=
