    {
      "id": "r01",
      "category": "route",
      "input": "这趟有点累，少走点路，能坐车就坐车",
      "context": { "route_id": "heritage_fullday", "preference": { "duration": "full-day", "party_size": 2, "travel_type": ["friends"], "interests": ["history"], "physical": [], "language": "zh-CN" } },
      "expect": { "physical": ["less-walk"], "removed_tail": true, "keywords_any": ["少走", "步行", "末端", "负担"] },
      "source": "xhs 评论：「我看全是步行，感觉自己没法暴走这么多路…景点直接都有公交吗？」"
    },
